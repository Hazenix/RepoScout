  "narrative": {
    "northStar": "开源研究田野笔记",
    "overview": "RepoScout 是供一人反复核对仓库、审查状态和机会历史的工作台。暖纸底与细线分隔形成安静的阅读面；深松绿标识可行动的信息，少量赭橙标记序号、计数和需要留意的状态。信息密度来自清晰的行、标题、时间与状态关系，不靠装饰制造层级。",
    "keyCharacteristics": [
      "暖纸色底、近白内容面、细线分隔；静态列表默认平面呈现。",
      "松绿承担链接、当前 tabs 和主要操作；赭橙仅作辅助标记与错误提示。",
      "仓库与机会按行扫描，状态徽章和报告链接紧邻对象。"
    ],
    "rules": [
      {
        "name": "The Two Accent Rule",
        "body": "松绿表达当前路径与可行动信息；赭橙只为计数、序号、异常及焦点提供第二层提示。",
        "section": "colors"
      },
      {
        "name": "The One Serif Rule",
        "body": "衬线用于页标题，导航、链接、状态和操作维持统一的系统无衬线字体。",
        "section": "typography"
      },
      {
        "name": "The Flat Ledger Rule",
        "body": "仓库与机会保持平面行式记录；只有输入区、空状态和通知需要独立色面。",
        "section": "elevation"
      }
    ],
    "dos": [
      "用细线、字重和留白划分记录，保留列表的快速扫描感。",
      "让状态文字与报告链接紧靠所属仓库或机会，并保留历史与本轮的区分。",
      "在窄屏把动作放到记录内容之后，维持至少 44px 的触控高度。"
    ],
    "donts": [
      "把每条记录包装成悬浮卡片或加入阴影。",
      "把赭橙扩展成主要按钮或大面积底色。",
      "只凭颜色传达已完成、待复核、失败或未完成等状态。"
    ]
  }
}
